# ==========================================
# KON AI - Local Environment Configuration
# ==========================================

APP_NAME=KON AI
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL with SQLite fallback)
DATABASE_URL=sqlite:///./kon_ai.db

# Vector Store (hybrid / local vector store)
QDRANT_URL=http://localhost:6333
VECTOR_STORE_TYPE=hybrid

# LLM Providers (Llama 3.1 / Indic models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
GROQ_API_KEY=

# Audio / Voice (STT & TTS)
WHISPER_MODEL=base
TTS_ENGINE=gTTS

# Security & Auth
JWT_SECRET=kon_ai_super_secret_jwt_key_india_rights_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Frontend Next.js environment
NEXT_PUBLIC_API_URL=http://localhost:8000
