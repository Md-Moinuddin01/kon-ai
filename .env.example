# ==========================================
# KON AI - Environment Configuration
# ==========================================

# Application
APP_NAME=KON AI
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL with SQLite fallback)
DATABASE_URL=sqlite:///./kon_ai.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://konuser:konpassword@localhost:5432/kon_ai_db

# Redis Cache & Rate Limiter
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CACHE=False

# Vector Store (Qdrant with fallback to local Chroma / In-Memory Vector Store)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
VECTOR_STORE_TYPE=hybrid

# LLM Providers (Llama 3.1 / Indic models)
# Option 1: Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Option 2: Groq Cloud API (fast Indic & Llama fallback)
GROQ_API_KEY=

# Option 3: OpenAI (optional fallback)
OPENAI_API_KEY=

# Embeddings & Reranker
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Audio / Voice (STT & TTS)
WHISPER_MODEL=base
TTS_ENGINE=gTTS

# Security & Auth
JWT_SECRET=kon_ai_super_secret_jwt_key_india_rights_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting
RATE_LIMIT_PER_MINUTE=20

# Frontend Next.js environment
NEXT_PUBLIC_API_URL=http://localhost:8000
